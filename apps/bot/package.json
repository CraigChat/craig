{
  "name": "@craig/bot",
  "version": "1.0.0",
  "description": "Craig Discord bot",
  "private": true,
  "type": "module",
  "main": "dist/index.mjs",
  "license": "MIT",
  "scripts": {
    "start": "dotenv -e ../../.env -e .env -c -- node dist/index.mjs",
    "start:sharding": "dotenv -e ../../.env -e .env -c -- node dist/sharding/index.mjs",
    "start-pm2": "dotenv -e ../../.env -e .env -c -- pm2 start ecosystem.config.cjs",
    "reload-pm2": "dotenv -e ../../.env -e .env -c -- pm2 reload ecosystem.config.cjs --update-env",
    "build": "rimraf dist && tsdown && pnpm sentry:sourcemaps",
    "sentry:sourcemaps": "dotenv -e sentry.env -c -- node scripts/sentry-sourcemaps.mjs",
    "dev": "dotenv -e ../../.env -e .env -c -- tsx src/index",
    "dev:sharding": "dotenv -e ../../.env -e .env -c -- tsx src/sharding/index",
    "sync": "dotenv -e ../../.env -e .env -c -- slash-up sync",
    "sync:dev": "dotenv -e ../../.env -e .env -c -- slash-up sync -e development",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "instance": "node scripts/instance.mjs"
  },
  "dependencies": {
    "@craig/common": "workspace:*",
    "@craig/db": "workspace:*",
    "@craig/logger": "workspace:*",
    "@craig/metrics": "workspace:*",
    "@discordjs/opus": "^0.10.0",
    "@henrygd/semaphore": "catalog:",
    "@projectdysnomia/dysnomia": "github:Snazzah/dysnomia#da3811d70a678bf58480bf99b14fffeb55161427",
    "@sentry/node": "^11.6.0",
    "@snazzah/davey": "^0.2.0-beta.1",
    "@snazzah/emoji-sync": "^0.1.2",
    "common-tags": "catalog:",
    "cron": "catalog:",
    "fastify": "catalog:",
    "fastq": "^1.19.1",
    "i18next": "^25.7.2",
    "i18next-fs-backend": "^2.6.1",
    "intl-messageformat": "^10.7.18",
    "ioredis": "catalog:",
    "nanoid": "catalog:",
    "slash-create": "^6.8.1",
    "sodium-native": "^5.1.0",
    "verkit": "^0.5.0",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@sentry/cli": "^2.58.6",
    "@types/common-tags": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "^7.7.1",
    "@types/ws": "catalog:",
    "slash-up": "^1.2.0",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "undici-types": "^7.16.0"
  }
}
