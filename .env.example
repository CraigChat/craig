# This will propogate to all apps, which is fine if you are running it straight off of the monorepo
# If these are empty, they will default to the project folder with a "rec" and "output" folder
# These folders MUST be created or else the service may not work
REC_DIRECTORY=
OUTPUT_DIRECTORY=
DOWNLOADS_DIRECTORY=
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# Max connections per app process (default 2)
# DATABASE_POOL_MAX=2

# Milliseconds to wait for a free connection before erroring (default 10000)
# DATABASE_CONNECTION_TIMEOUT=10000

# REQUIRED: Encrypt tokens stored in the database
# Format is <version>:<key>, generate the key with `openssl rand -base64 32`. To rotate, append a
# higher version (1:<key>,2:<key>), restart all services, run `pnpm encrypt-tokens --write`, then
# remove the old key and restart again
TOKEN_ENCRYPTION_KEYS=1:

